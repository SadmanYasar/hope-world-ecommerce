{
  "name": "hope-world-ecommerce",
  "packageManager": "yarn@4.7.0",
  "license": "GPL-3.0-only",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "storefront": "yarn --cwd apps/frontend_storefront dev",
    "admin": "yarn --cwd apps/frontend_admin dev",
    "dev": "npm-run-all --parallel storefront admin"
  },
  "dependencies": {
    "jwt-decode": "^4.0.0",
    "npm-run-all": "^4.1.5",
    "react-dropzone": "^14.3.8"
  }
}
